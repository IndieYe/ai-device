# 传输模式: stdio (默认) / http / sse
TRANSPORT=stdio

# HTTP/SSE 配置（仅在 TRANSPORT=http 或 sse 时生效）
SSE_HOST=localhost
SSE_PORT=8000

# 主服务到 Bash MCP 的私有身份令牌。配置后，只有携带匹配
# X-AI-Assistant-Caller-Context 请求头的 HTTP/SSE 调用可将调用 metadata
# 中的 assistant.session_id 投影为 AI_ASSISTANT_CALLER_SESSION_ID。
# 留空时一律不投影调用会话上下文。
BASH_CALLER_CONTEXT_TOKEN=

# 默认工作目录（为空时使用 os.getcwd()）
DEFAULT_CWD=

# 输出截断阈值（字节），超出时保留头部
BASH_MAX_OUTPUT_BYTES=65536

# 结构化参数、脚本与 stdin 大小限制
BASH_MAX_ARGV_COUNT=4096
BASH_MAX_ARGV_BYTES=262144
BASH_MAX_SCRIPT_BYTES=1048576
BASH_MAX_STDIN_BYTES=4194304

# run/script 受管临时资源
BASH_ARTIFACT_DIR=/tmp/mcp-server-bash/artifacts
BASH_ARTIFACT_TTL_SECONDS=86400

# 命令完整输出目录（stdout/stderr 合并写入同一个文件）
BASH_OUTPUT_DIR=/tmp/mcp-server-bash/outputs

# 单个命令输出文件的字节上限。超出时清空该文件、终止命令并返回
# OUTPUT_LIMIT_EXCEEDED 错误，避免一次失控输出写爆磁盘。
BASH_MAX_OUTPUT_FILE_BYTES=104857600

# 输出文件的保留时长（秒），服务启动时清理更早的文件。默认 7 天。
# 注意：BASH_OUTPUT_DIR 若指向 /tmp 之外，就不会再被系统自动回收，
# 需要依赖这里的保留策略。
BASH_OUTPUT_TTL_SECONDS=604800

# 服务日志配置
SERVER_LOG_ENABLED=true
SERVER_LOG_LEVEL=INFO
SERVER_LOG_DIR=logs/server
