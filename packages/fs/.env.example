# MCP Filesystem Server 配置示例
# 复制此文件为 .env 并修改配置

# 临时文件目录（用于存放大文件结果）
# 默认: ~/.mcp-server-fs
MCP_TEMP_DIR=~/.mcp-server-fs

# 传输模式: stdio 或 sse
# stdio: 通过标准输入/输出通信（适合 Claude Desktop、Kiro 等客户端）
# sse: 通过 HTTP Server-Sent Events 通信（适合 Web 应用集成）
# 默认: stdio
MCP_TRANSPORT=stdio

# SSE 模式配置（仅在 MCP_TRANSPORT=sse 时生效）
# 绑定的主机地址，默认: 127.0.0.1
MCP_HOST=127.0.0.1

# 绑定的端口，默认: 8000
MCP_PORT=8000
