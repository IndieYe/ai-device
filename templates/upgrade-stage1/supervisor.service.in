# REVIEW ONLY: fixed request, no timer, no boot auto-start, no Restart.
[Unit]
Description=Device isolated one-shot upgrade @CLIENT_UNIT@
After=network-online.target

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=@ROOT@
ExecStart=@SUPERVISOR_PYTHON@ -I -B -m device_runtime.cli upgrade supervise --root @ROOT@ --upgrade-id @UPGRADE_ID@ --confirm-service-change
Restart=no
TimeoutStartSec=900
KillMode=control-group
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=@ROOT@
ReadOnlyPaths=@ROOT@/run @ROOT@/upgrade-profile.json @ROOT@/config @ROOT@/releases @SUPERVISOR_HOME@
# No PartOf/BindsTo/Requires=client: stop(client) must not stop the upgrader.
# root is required by this initial system-manager adapter, not claimed least-privilege.
# Do not add an Install section or timer: each request needs explicit approval.
