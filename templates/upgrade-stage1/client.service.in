# REVIEW ONLY: explicit standard-layout client, not a drop-in for legacy units.
[Unit]
Description=Device managed client @CLIENT_UNIT@
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@CLIENT_USER@
Group=@CLIENT_GROUP@
WorkingDirectory=@ROOT@
Environment=PATH=/usr/local/bin:/usr/bin:/bin
EnvironmentFile=@TOKEN_FILE@
ExecStart=@ROOT@/run client
Restart=on-failure
RestartSec=5
KillMode=control-group
TimeoutStopSec=120
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=@ROOT@/state/client
# This client can no longer write arbitrary host paths. Review workload scope;
# do not silently disable this protection to emulate a legacy unrestricted client.

[Install]
WantedBy=multi-user.target
